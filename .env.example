# Copy this file to .env and set your own Gemini API key.
GEMINI_API_KEY=

# Model settings
MODEL_NAME=gemini-3.5-flash-lite
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval and text chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# Generation settings
LLM_TEMPERATURE=0.7
MAX_TOKENS=2048
MAX_HISTORY_TOKENS=2000
